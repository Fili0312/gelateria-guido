# Gelateria Guido — variabili d'ambiente
#
# Copiare in `.env` e riempire. Il `.env` non entra mai in git.

# --- Database -------------------------------------------------------------
# Postgres locale, database e ruolo dedicati (decisione D3).
DATABASE_URL="postgresql://gelateria:METTI_LA_PASSWORD@127.0.0.1:5432/gelateria_guido?schema=public"

# --- Applicazione ---------------------------------------------------------
# Percorso pubblico dietro nginx (decisione D1). Lasciare vuoto in locale.
NEXT_BASE_PATH="/gelateria"
# URL pubblico completo, per i link assoluti (email, export).
APP_URL="https://filippo.eventoyou.com/gelateria"
NODE_ENV="production"
PORT="3030"

# --- Accesso --------------------------------------------------------------
# Password unica condivisa (decisione D4): qui va l'HASH, mai la password in
# chiaro. `pnpm auth:hash` stampa l'intera riga pronta da incollare, con i `$`
# escapati come richiede il parser dei file .env di Next.
APP_PASSWORD_HASH=""
# Segreto per firmare il cookie di sessione. Generare con:
#   openssl rand -base64 48
SESSION_SECRET=""

# --- Archiviazione --------------------------------------------------------
# PDF dei listini ed export generati. Fuori dal repo, dentro il backup.
STORAGE_DIR="/var/www/gelateria-guido/storage"

# --- Intelligenza artificiale (serve dalla FASE 8) ------------------------
# Motore di analisi dei listini: deepseek | claude | mock
AI_PROVIDER="deepseek"
# Salta ogni chiamata esterna e usa un provider finto: obbligatorio nei test.
AI_MOCK="0"
# Chiave DeepSeek. Vive solo in questo processo: mai nel frontend, mai nei
# log, mai a database.
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-v4-flash"
DEEPSEEK_TIMEOUT_MS="60000"
# Righe per chiamata: lotti piccoli = più attenzione per riga.
AI_BATCH_SIZE="6"
# Tetto di spesa mensile in dollari. Superato, i job si fermano e chiedono
# conferma invece di continuare a spendere (decisione D11).
AI_MONTHLY_BUDGET_USD="10"

# --- Invio ordini ai fornitori (serve dalla FASE 17) ----------------------
# MODALITÀ DI INVIO — di serie "log": le email vengono scritte su file e NON
# spedite. È il default apposta: un ordine mandato per sbaglio a un fornitore
# vero non si richiama indietro. Si passa a "smtp" solo dopo aver collaudato.
#   log  = scrive in storage/email/ e non spedisce nulla
#   smtp = spedisce davvero
MAIL_MODE="log"
MAIL_HOST="smtps.aruba.it"
MAIL_PORT="587"
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_FROM_ADDRESS=""
MAIL_FROM_NAME="Gelateria Guido"
# Indirizzo a cui rispondono i fornitori: deve essere una casella vera e
# presidiata, non un noreply.
MAIL_REPLY_TO=""
# Copia di ogni ordine inviato a sé stessi: è la prova di cosa è partito.
MAIL_BCC_SELF=""
# 1 = manda automaticamente alla conferma dell'ordine.
# 0 = mostra prima l'anteprima con destinatari e allegati, e aspetta un click.
MAIL_SEND_AUTOMATICALLY="0"

# --- Soglie di dominio ----------------------------------------------------
# Avviso "esiste di meglio" solo se ENTRAMBE le soglie sono superate,
# altrimenti diventa rumore che si impara a ignorare (ANALISI §8).
BEST_PRICE_MIN_PCT="3"
BEST_PRICE_MIN_EUR="0.30"
# Un prezzo più vecchio di così è dichiarato non aggiornato.
PRICE_STALE_AFTER_MONTHS="6"
# Variazione oltre la quale un prezzo importato richiede conferma esplicita.
PRICE_CHANGE_ALERT_PCT="40"
