# Backup giornaliero del database e dello storage di Gelateria Guido.
# Lo script usa un lock non bloccante: un secondo avvio non si sovrappone.

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

30 3 * * * root umask 077; /var/www/gelateria-guido/scripts/backup-db.sh >> /var/log/gelateria-backup.log 2>&1
